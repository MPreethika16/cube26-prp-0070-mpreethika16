# Copy to .env.local for local development (never commit .env.local).

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini Multimodal API Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL RLS Configuration (Docker port 5434)
# Admin / Migration URL
DATABASE_ADMIN_URL=postgresql://prep_admin:prep_admin_secure_pass_2026@localhost:5434/prep_manager
# Constrained Application URL (Non-owner, NO BYPASSRLS - used by runtime & RLS tests)
DATABASE_URL=postgresql://prep_app:prep_app_secure_pass_2026@localhost:5434/prep_manager

